## Backend and managed database. Do not put real values in Git.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/pinterval
SECRET_KEY=replace-with-a-long-random-secret
COOKIE_SECURE=true
SESSION_MAX_AGE_SECONDS=43200
CORS_ORIGINS=https://tacahu-ops.vercel.app
# Leave blank in production. Set a narrowly scoped expression only when a Vercel
# Preview deployment must call this API, for example: https://.*\\.vercel\\.app
CORS_ORIGIN_REGEX=
REDIS_URL=redis://redis:6379/0
CRAWL_INTERVAL_SECONDS=300
STATUS_SYNC_INTERVAL_SECONDS=300

## Prebuilt image used by compose.yaml. Use an immutable sha-* tag in production.
BACKEND_IMAGE=ghcr.io/hongphuc05/pinterva-manager-backend
BACKEND_VERSION=sha-replace-with-published-commit
BACKEND_PORT=8000

## Enable only after a Cloudflare Tunnel hostname has been configured to target
## http://api:8000 inside this Compose project.
DEPLOY_WITH_TUNNEL=false
CLOUDFLARE_TUNNEL_TOKEN=
