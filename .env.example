## Production Backend & Managed PostgreSQL
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/pinterval
SECRET_KEY=replace-with-exact-secret-from-render
COOKIE_SECURE=true
SESSION_MAX_AGE_SECONDS=43200
CORS_ORIGINS=https://tacahu-ops.vercel.app
CORS_ORIGIN_REGEX=
REDIS_URL=redis://redis:6379/0
CRAWL_INTERVAL_SECONDS=300
STATUS_SYNC_INTERVAL_SECONDS=300
STATUS_SYNC_HEARTBEAT_INTERVAL_SECONDS=20
STATUS_SYNC_HEARTBEAT_STALE_SECONDS=180
PRINTERVAL_MANUAL_SYNC_CONCURRENCY=4

## Optional Support duplicate-image comparison (disabled by default)
SUPPORT_COMPARE_ENABLED=false
SUPPORT_COMPARE_MODEL_NAME=facebook/dinov2-base
SUPPORT_COMPARE_MODEL_VERSION=
SUPPORT_COMPARE_BATCH_LIMIT=100
# Optional safety cap; leave unset to scan all Waiting + Doing orders.
# SUPPORT_COMPARE_SCAN_LIMIT=1000
SUPPORT_COMPARE_EMBEDDING_BATCH_SIZE=16
SUPPORT_COMPARE_INTERVAL_SECONDS=1800

## Application Image & Paths
BACKEND_IMAGE=tacahu-backend
APP_VERSION=latest
APP_SOURCE_DIR=./app
DATA_DIR=./data
BACKEND_PORT=8000

## Cloudflare Tunnel
## Must point tunnel route to internal service: http://api:8000
DEPLOY_WITH_TUNNEL=false
CLOUDFLARE_TUNNEL_TOKEN=
