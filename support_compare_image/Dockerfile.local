# Support machine image: the DINOv2 compute agent (agent.py) and, optionally, the 1-1 compare tool.
# Python code is bind-mounted by compose.yaml, so this image holds dependencies only.
# Docker on macOS has no GPU access: for Apple-GPU (MPS) speed run the agent natively (see README).

FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    HF_HOME=/models

# CPU wheels first; the runtime requirements below are then already satisfied.
RUN pip install torch torchvision --index-url https://download.pytorch.org/whl/cpu

COPY requirements.compare-runtime.txt ./
RUN pip install -r requirements.compare-runtime.txt \
    fastapi "uvicorn[standard]" python-multipart

WORKDIR /app/dup-compare
