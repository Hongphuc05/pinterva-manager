# Use the production database through a private network or SSH tunnel.
# Never commit the real file.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@127.0.0.1:15432/DB_NAME

PRINTERVAL_API_BASE_URL=https://printerval.com
PRINTERVAL_TEAM_OUTSOURCE=thuyhuong

# Use either a complete Cookie header or username/password.
# A complete cookie is short-lived and must not be committed.
PRINTERVAL_SESSION_COOKIE=
PRINTERVAL_USERNAME=
PRINTERVAL_PASSWORD=

PRINTERVAL_PAGE_SIZE=100
PRINTERVAL_REQUEST_DELAY_SECONDS=0.25
PRINTERVAL_TIMEOUT_SECONDS=30
PRINTERVAL_MAX_RETRIES=5

# Duplicate comparison runner (Phase 1: Hugging Face DINOv2)
EMBEDDING_MODEL_NAME=facebook/dinov2-base
MODEL_VERSION=facebook/dinov2-base
EMBEDDING_DIM=768
EMBEDDING_BATCH_SIZE=16
TOP_K_CANDIDATES=5
IMAGE_FETCH_TIMEOUT_SECONDS=30
