# Copy to .env.agent (gitignored) on the Support machine.

# Tacahu API (https://<api-domain>, without /api) and the web app whose page may control this agent
# (only this origin can talk to the agent on localhost).
SUPPORT_API_URL=https://tacahu.fun
SUPPORT_WEB_URL=https://tacahu.fun
# How this machine is shown on the web (Hàng đợi).
AGENT_NAME=MacBook-Phuc

# DINO runtime. MODEL_VERSION must match the pool's model_version in the database.
EMBEDDING_MODEL_NAME=facebook/dinov2-base
MODEL_VERSION=facebook/dinov2-base
EMBEDDING_DIM=768
EMBEDDING_BATCH_SIZE=16
TOP_K_CANDIDATES=10
IMAGE_FETCH_TIMEOUT_SECONDS=30
AGENT_POLL_SECONDS=5
# Port the web page uses to reach the agent on this machine (default 8765).
# AGENT_PORT=8765
# Extra web origins allowed to control the agent, comma separated (e.g. local frontend dev).
# AGENT_ALLOWED_ORIGINS=http://localhost:5173
# cuda / mps / cpu (auto-detected when unset; mps only works when the agent runs natively on a Mac)
# EMBEDDING_DEVICE=
