# Copy to .env.production on the VPS. Never commit .env.production.
# All values below are placeholders and must be replaced before startup.

ENVIRONMENT=production
APP_VERSION=replace-with-git-sha-or-release-tag
DATA_DIR=/srv/tacahu-ops/data
BACKEND_PORT=8000

# Backups are written locally first. rclone is optional and configured on the VPS,
# never with cloud-storage credentials committed to this file.
BACKUP_DIR=/srv/tacahu-ops/backups
BACKUP_RETENTION_DAYS=14
BACKUP_INCLUDE_CHROME_PROFILES=false
BACKUP_OFFSITE_RCLONE_REMOTE=

POSTGRES_DB=tacahu_ops
POSTGRES_USER=tacahu
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql+psycopg://tacahu:replace-with-url-encoded-password@postgres:5432/tacahu_ops
REDIS_URL=redis://redis:6379/0

SECRET_KEY=replace-with-a-random-32-plus-character-secret
COOKIE_SECURE=true
SESSION_MAX_AGE_SECONDS=43200
CORS_ORIGINS=https://tacahu.fun
CORS_ORIGIN_REGEX=

CRAWL_INTERVAL_SECONDS=300
STATUS_SYNC_INTERVAL_SECONDS=300
PRINTERVAL_MANUAL_SYNC_CONCURRENCY=4

# Enable this profile only after creating a Cloudflare Tunnel whose public hostname
# tacahu.fun routes to http://api:8000.
CLOUDFLARE_TUNNEL_TOKEN=

# Reserved for Phase 3. The credential JSON remains outside the repository.
GOOGLE_SERVICE_ACCOUNT_FILE=/run/secrets/google-service-account.json
# Leave blank while reporting is disabled. Set the VPS path only after the JSON exists.
GOOGLE_SERVICE_ACCOUNT_HOST_FILE=
GOOGLE_SHEETS_ORDER_BACKUP_URL=
GOOGLE_SHEETS_ORDER_BACKUP_TAB=Order Backup
ORDER_SHEET_BACKUP_ENABLED=false
ORDER_SHEET_BACKUP_HOUR=0
ORDER_SHEET_BACKUP_MINUTE=10
CELERY_TIMEZONE=Asia/Ho_Chi_Minh
